# Maintainer: Petr Mrázek <peterix@gmail.com>
# Generated by build.py in https://github.com/MultiMC/Packaging from arch/PKGBUILD.in: edit there.
pkgname=multimc-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Free, open source launcher and instance manager for Minecraft."
arch=('any')
url="https://multimc.org/"
license=('Apache-2.0')
depends=('bash' 'hicolor-icon-theme' 'zlib' 'opengl-driver' 'qt5-base' 'qt5-svg' 'java-runtime' 'zenity' 'wget')
optdepends=('xorg-xrandr: for older Minecraft versions'
            'visualvm: profiling support'
            'openal: to use the system OpenAL libraries'
            'glfw: to use the system GLFW libraries')
makedepends=('make')
provides=('multimc' 'multimc5')
conflicts=('multimc' 'multimc5')
replaces=('multimc-native')
source=("https://files.multimc.org/downloads/multimc-wrapper-$pkgver.tar.gz")
sha256sums=('@SOURCE_SHA256@')

package() {
    cd "multimc-wrapper-$pkgver"
    # what goes where is the Makefile's
    make install DESTDIR="$pkgdir"
}
